# ── 依赖布局 ──────────────────────────────────────────────────
# 保持 pnpm 的符号链接严格布局（同时是默认值，显式写出是为了把纪律写进代码）。
# 效果：组件里 import 了未在 package.json 声明的包，本地直接报错，而不是静默通过。
# 这是发布质量的前置防线，不要为了"先跑通"改成 true。
shamefully-hoist=false

# ── peer 依赖处理 ─────────────────────────────────────────────
# 自动安装 peer 依赖。库项目把 react/react-dom 声明在 peerDependencies，
# 本地开发需要它们真实存在，靠这一项兜住，省去再手工往 devDependencies 抄一遍。
auto-install-peers=true

# 分阶段决策：暂时关闭严格 peer 校验。
# 原因：生态里大量插件的 peer 范围标注不准确，一开始就开 strict 会卡在安装阶段。
# 计划：阶段 10 依赖树定型后改为 true，个别不准确的包用 package.json 的
#       pnpm.peerDependencyRules 白名单兜住。
strict-peer-dependencies=false
